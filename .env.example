# Bright Data Credentials & Active Web Unlocker Zone
BRIGHTDATA_ENABLED=false
BRIGHTDATA_HOST=brd.superproxy.io
BRIGHTDATA_PORT=22225
BRIGHTDATA_CUSTOMER_ID=your_customer_id
BRIGHTDATA_ZONE=web_unlocker1
BRIGHTDATA_USERNAME=your_username
BRIGHTDATA_PASSWORD=your_password
BRIGHTDATA_API_KEY=your_api_key

# Strict Cost Guardrails (Protects User from Excessive Costs)
BRIGHTDATA_MAX_REQUESTS=52
BRIGHTDATA_MAX_REQUESTS_PER_TARGET=1
BRIGHTDATA_MAX_BANDWIDTH_MB=25.0
BRIGHTDATA_DELAY_BETWEEN_REQUESTS_SEC=1.0
BRIGHTDATA_MAX_RETRIES=0
BRIGHTDATA_PROBE_ONLY=true

# Firecrawl Configuration
FIRECRAWL_API_KEY=your_firecrawl_api_key
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# sFTP Push Delivery Configuration (Contractual Daily Feed)
SFTP_ENABLED=false
SFTP_HOST=sftp.client-domain.com
SFTP_PORT=22
SFTP_USERNAME=intel_feed_user
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=/path/to/private_key.pem
SFTP_REMOTE_PATH=/uploads/daily_feeds/
SFTP_MAX_RETRIES=3
SFTP_RETRY_BACKOFF_SEC=5
